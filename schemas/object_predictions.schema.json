{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "object_predictions.schema.json",
  "title": "Per-frame object-role decisions",
  "type": "object",
  "required": ["schema_version", "artifact_type", "storage_layout", "generation_id", "semantic_groups_prior", "summary", "frame_decisions"],
  "properties": {
    "schema_version": {"const": 4},
    "artifact_type": {"const": "object_role_predictions"},
    "storage_layout": {"type": "string", "enum": ["compact_v2", "debug_full_v2"]},
    "generation_id": {"type": "string"},
    "semantic_groups_prior": {"type": "array"},
    "summary": {"type": "object"},
    "performance": {"type": "object"},
    "frame_decisions": {"type": "array"},
    "decision": {"type": ["object", "null"]}
  }
}
