{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "episode_candidates.schema.json",
  "title": "Episode-level Stage-1 candidate manifest",
  "type": "object",
  "required": ["schema_version", "artifact_type", "summary", "episode_dir", "frames"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "episode_candidates"},
    "summary": {"type": "object"},
    "units": {"type": "object"},
    "episode_dir": {"type": "string"},
    "instruction": {"type": "string"},
    "role_spec": {"type": "object"},
    "camera_names": {"type": "array", "items": {"type": "string"}},
    "frames": {"type": "array"}
  }
}
