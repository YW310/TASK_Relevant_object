{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "object_summary.schema.json",
  "title": "Cross-frame object tracks and role-decision input",
  "type": "object",
  "required": ["schema_version", "generation_id", "source_fused_json", "object_tracks", "frame_decision_inputs"],
  "properties": {
    "schema_version": {"const": 3},
    "artifact_type": {"const": "object_track_summary"},
    "generation_id": {"type": "string", "format": "uuid"},
    "coordinate_frame": {"type": "string"},
    "units": {"type": "object"},
    "summary": {"type": "object"},
    "source_fused_json": {"type": ["string", "null"]},
    "object_tracks": {"type": "array"},
    "frame_decision_inputs": {"type": "array", "items": {
      "type": "object", "required": ["frame_id", "frame_ref", "candidate_objects", "pairwise_relations"],
      "properties": {"frame_ref": {"type": "string"}}
    }}
  }
}
